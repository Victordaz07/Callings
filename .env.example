# --- Storage cifrado E2EE (Prisma + Neon) ---
# DATABASE_URL: conexión pooled (PgBouncer) — la usa Prisma Client en runtime.
# DIRECT_URL: conexión directa, sin pooler — la usa el CLI de Prisma (migrate/studio).
# En Neon: Dashboard del proyecto → Connect → copia ambas variantes.
DATABASE_URL=
DIRECT_URL=

# NextAuth — genera uno con: npx auth secret
AUTH_SECRET=

# Integración Upstash Redis (Vercel Marketplace) o KV directo.
# (vigente hasta migrar Ajustes/Secretario a Postgres — ver decisión de reemplazo total)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
